{
  "code": "UPI_10_TXNS",
  "changeNote": "Initial version",
  "definition": {
    "name": "10 UPI payments in a month",
    "description": "Make 10 UPI payments of ₹10 or more (self transfers excluded).",
    "businessObjective": "Drive UPI activity",
    "category": "FREQUENCY",
    "campaignCode": "MXP_ALWAYS_ON",
    "kind": "GOAL",
    "scope": {
      "channels": [
        "UPI"
      ],
      "productCodes": []
    },
    "eligibility": {
      "type": "group",
      "op": "AND",
      "negate": false,
      "children": [
        {
          "type": "condition",
          "field": "customer.status",
          "operator": "EQ",
          "value": "ACTIVE"
        }
      ]
    },
    "qualifying": {
      "type": "group",
      "op": "AND",
      "negate": false,
      "children": [
        {
          "type": "condition",
          "field": "txn.channel",
          "operator": "EQ",
          "value": "UPI"
        },
        {
          "type": "condition",
          "field": "txn.dr_cr",
          "operator": "EQ",
          "value": "D"
        },
        {
          "type": "condition",
          "field": "txn.amount",
          "operator": "GTE",
          "value": 10
        },
        {
          "type": "group",
          "op": "AND",
          "negate": true,
          "children": [
            {
              "type": "condition",
              "field": "txn.category",
              "operator": "IN",
              "value": [
                "SELF_TRANSFER"
              ]
            }
          ]
        }
      ]
    },
    "metric": {
      "type": "COUNT",
      "operator": "GTE"
    },
    "period": {
      "type": "MONTHLY",
      "timezone": "Asia/Kolkata"
    },
    "tiers": [
      {
        "label": "10 payments",
        "threshold": 10,
        "points": 100
      }
    ],
    "effective": {
      "from": "2026-09-01",
      "to": null
    },
    "priority": 100
  }
}
