{
  "kind": "RuleTemplate",
  "code": "MONTHLY_SPEND_LIMIT",
  "version": 1,
  "family": "SPEND_CONTROL",
  "name": "Monthly Spend Limit",
  "description": "Aggregate spend cap over a calendar month or a rolling 30-day window.",
  "icon": "📅",
  "category": "Spend limits",
  "summary": "Keep spend within {limit} per {windowType} window. Earn {points} points for each calendar month within it.",
  "params": [
    { "name": "limit", "label": "Monthly limit", "type": "money", "setBy": "CUSTOMER", "min": 1000, "max": 10000000, "step": 500 },
    { "name": "windowType", "label": "Window", "type": "enum", "setBy": "BANK", "options": ["MONTH", "ROLLING_DAYS"], "default": "MONTH", "description": "MONTH = calendar month. ROLLING_DAYS = the last 30 days, re-evaluated on every transaction." },
    { "name": "channels", "label": "Channels covered", "type": "enum[]", "setBy": "BANK", "optionsFrom": "channels", "default": ["CARD_POS", "CARD_ONLINE", "UPI", "NETBANKING"] },
    { "name": "action", "label": "When the limit is exceeded", "type": "enum", "setBy": "BANK", "options": ["ALERT", "BLOCK"], "default": "ALERT" },
    { "name": "warnAtPct", "label": "Warn at % of limit", "type": "percent", "setBy": "BANK", "default": 80 },
    { "name": "points", "label": "Points per compliant month", "type": "integer", "setBy": "BANK", "min": 0, "default": 100 },
    { "name": "minActivity", "label": "Minimum transactions in the month to earn", "type": "integer", "setBy": "BANK", "min": 1, "default": 5 }
  ],
  "logic": {
    "events": ["TRANSACTION"],
    "scope": {
      "all": [
        { "field": "event.dr_cr", "op": "eq", "value": "D" },
        { "field": "event.channel", "op": "in", "value": { "$param": "channels" } },
        { "field": "event.txn_type", "op": "not_in", "value": ["SELF_TRANSFER", "REFUND"] }
      ]
    },
    "measure": { "type": "SUM", "field": "event.amount" },
    "window": { "type": { "$param": "windowType" }, "days": 30, "period": "MONTH" },
    "goal": { "op": "lte", "target": { "$param": "limit" } },
    "control": { "action": { "$param": "action" }, "warnAtPct": { "$param": "warnAtPct" } },
    "reward": { "mode": "WINDOW_COMPLIANCE", "points": { "$param": "points" }, "minActivity": { "$param": "minActivity" } }
  }
}
