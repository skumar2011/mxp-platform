{
  "kind": "RuleTemplate",
  "code": "DORMANCY_PREVENTION",
  "version": 1,
  "family": "MISSION",
  "name": "Dormancy Prevention",
  "description": "Win back customers at risk of going dormant: transact on a few separate days this month. Target at-risk customers through the rule's eligibility.",
  "icon": "💤",
  "category": "Extension",
  "summary": "Transact at least {minAmount} on {activeDays} different days this month. Earn {points} points.",
  "params": [
    { "name": "activeDays", "label": "Active days required", "type": "integer", "setBy": "BANK", "min": 1, "max": 31, "default": 2 },
    { "name": "minAmount", "label": "Minimum amount per transaction", "type": "money", "setBy": "BANK", "min": 1, "default": 100 },
    { "name": "points", "label": "Points", "type": "integer", "setBy": "BANK", "min": 0, "default": 100 }
  ],
  "logic": {
    "events": ["TRANSACTION"],
    "scope": {
      "all": [
        { "field": "event.dr_cr", "op": "eq", "value": "D" },
        { "field": "event.txn_type", "op": "not_in", "value": ["SELF_TRANSFER", "REFUND"] }
      ]
    },
    "filter": { "field": "event.amount", "op": "gte", "value": { "$param": "minAmount" } },
    "measure": { "type": "DISTINCT_DAYS" },
    "window": { "type": "MONTH" },
    "goal": { "op": "gte", "target": { "$param": "activeDays" } },
    "reward": { "mode": "ON_GOAL", "points": { "$param": "points" } }
  }
}
