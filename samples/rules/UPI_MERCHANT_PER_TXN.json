{
  "code": "UPI_MERCHANT_PER_TXN",
  "changeNote": "Initial version",
  "definition": {
    "name": "1 XP per ₹100 on UPI merchant payments",
    "description": "Earn 1 XP for every ₹100 paid to a merchant through UPI, capped at 200 XP a month.",
    "businessObjective": "Merchant UPI adoption",
    "category": "ENGAGEMENT",
    "campaignCode": "MXP_ALWAYS_ON",
    "kind": "PER_EVENT",
    "scope": {
      "channels": [
        "UPI"
      ],
      "productCodes": []
    },
    "eligibility": {
      "type": "group",
      "op": "AND",
      "negate": false,
      "children": [
        {
          "type": "condition",
          "field": "customer.status",
          "operator": "EQ",
          "value": "ACTIVE"
        }
      ]
    },
    "qualifying": {
      "type": "group",
      "op": "AND",
      "negate": false,
      "children": [
        {
          "type": "condition",
          "field": "txn.type",
          "operator": "EQ",
          "value": "MERCHANT_PAYMENT"
        },
        {
          "type": "condition",
          "field": "txn.dr_cr",
          "operator": "EQ",
          "value": "D"
        }
      ]
    },
    "perEvent": {
      "mode": "PER_AMOUNT",
      "points": 1,
      "perAmount": 100
    },
    "period": {
      "type": "MONTHLY",
      "timezone": "Asia/Kolkata"
    },
    "limits": {
      "capPointsPerPeriod": 200
    },
    "priority": 200
  }
}
